import kotlinx.cinterop.*
import {{ namespace }}.cinterop.*

// Wire up the Kotlin/Native handle-release callback to the C-ABI symbol.
// This runs once when the object is first accessed.

@OptIn(ExperimentalForeignApi::class)
private val _runtimeInit: Unit = run {
    KoffiRuntime.releaseHandle = { handleId ->
        koffi_handle_release(handleId.toULong())
    }
}

/**
 * Read a [KoffiByteBuf] returned from Rust into a Kotlin [ByteArray] and free
 * the Rust-owned memory. Must be called inside a [memScoped] block.
 */
@OptIn(ExperimentalForeignApi::class)
private fun MemScope.readAndFreeByteBuf(buf: KoffiByteBuf): ByteArray {
    val len = buf.len.toInt()
    val bytes = ByteArray(len)
    if (len > 0 && buf.ptr != null) {
        bytes.usePinned { pinned ->
            platform.posix.memcpy(pinned.addressOf(0), buf.ptr, buf.len)
        }
    }

    koffi_free_byte_buf(buf.readValue())

    return bytes
}

/**
 * Encode a [String] to UTF-8 and call [block] with a pinned pointer and length.
 * The pointer is only valid for the duration of [block].
 */
@OptIn(ExperimentalForeignApi::class)
private fun <R> String.withUtf8Bytes(block: (ptr: CPointer<UByteVar>, len: ULong) -> R): R {
    val bytes = encodeToByteArray()

    return bytes.usePinned { pinned ->
        block(pinned.addressOf(0).reinterpret(), bytes.size.toULong())
    }
}

/**
 * Pin a [ByteArray] and call [block] with a pointer and length.
 */
@OptIn(ExperimentalForeignApi::class)
private fun <R> ByteArray.withPinnedBytes(block: (ptr: CPointer<UByteVar>, len: ULong) -> R): R {
    return usePinned { pinned ->
        block(pinned.addressOf(0).reinterpret(), size.toULong())
    }
}

