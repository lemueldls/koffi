@OptIn(ExperimentalWasmJsInterop::class)
private fun ByteArray.toJsUint8Array(): JsAny {
    val len = this.size
    val arr: JsAny = js("new Uint8Array(len)")
    for (i in 0 until len) {
        val b = this[i].toInt() and 0xFF
        js("arr[i] = b")
    }
    return arr
}

@OptIn(ExperimentalWasmJsInterop::class)
private fun JsAny.toByteArray(): ByteArray {
    val arr = this
    val len: Int = js("arr.length")
    return ByteArray(len) { i ->
        (js("arr[i]").unsafeCast<JsNumber>().toDouble().toInt() and 0xFF).toByte()
    }
}

{%- if emit_handle_release %}
@Suppress("unused")
private val _koffiWasmInit: Unit = run {
    KoffiRuntime.releaseHandle = { handleId ->
        koffi_handle_release(handleId.toDouble())
    }
}
{%- endif %}

