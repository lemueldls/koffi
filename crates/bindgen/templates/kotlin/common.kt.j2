{#- commonMain: expect declarations -#}

package {{ ir.namespace }}

{# {%~ for i in ir.imports %}
import {{ i | qualified_name }}
{%- endfor %} #}

{#~ Data types -#}
{%- for s in ir.structs %}
{%- if !s.is_opaque %}
{%- if s.doc.len() > 0 %}
/**
{%- for line in s.doc %}
 *{{ line }}
{%- endfor %}
 */
{%- endif %}
data class {{ s.name }}(
{%- for field in s.fields %}
    val {{ field.name | kotlin_sanitize_ident }}: {{ field.ty | kotlin_type }},
{%- endfor %}
) {
    fun writeDataWire(writer: rs.koffi.KoffiWriter) {
{%- for field in s.fields %}
{%- if !field.skip_serde %}
        writer.{{ field.ty | kotlin_writer_expr(field.name) }}
{%- endif %}
{%- endfor %}
    }

    companion object {
        fun readDataWire(reader: rs.koffi.KoffiReader) =
            {{ s.name }}(
{%- for field in s.fields %}
{%- if !field.skip_serde %}
                {{ field.name | kotlin_sanitize_ident }} = reader.{{ field.ty | kotlin_reader_expr }},
{%- endif %}
{%- endfor %}
            )
    }
}
{%- endif %}
{%- endfor %}

{#- Enum / error types -#}
{%~ for e in ir.enums %}
{%- if e.doc.len() > 0 %}
/**
{%- for line in e.doc %}
 *{{ line }}
{%- endfor %}
 */
{%- endif %}
sealed class {{ e.name }} : rs.koffi.KoffiError() {
{%- for variant in e.variants %}
{%- if variant.fields.is_empty() %}
    class {{ variant.name }} : {{ e.name }}()
{%- else %}
    data class {{ variant.name }}(
{%- for field in variant.fields %}
        val {{ field.name | kotlin_sanitize_ident }}: {{ field.ty | kotlin_type }},
{%- endfor %}
    ) : {{ e.name }}()
{%- endif %}
{%- endfor %}
    fun writeDataWire(writer: rs.koffi.KoffiWriter) {
        when (this) {
{%- for variant in e.variants %}
{%- if variant.fields.is_empty() %}
            is {{ variant.name }} -> {
                writer.writeByte({{ loop.index0 }})
            }
{%- else %}
            is {{ variant.name }} -> {
                writer.writeByte({{ loop.index0 }})
{%- for field in variant.fields %}
{%- if !field.skip_serde %}
                writer.{{ field.ty | kotlin_writer_expr(field.name) }}
{%- endif %}
{%- endfor %}
            }
{%- endif %}
{%- endfor %}
        }
    }

    companion object {
        fun readDataWire(reader: rs.koffi.KoffiReader): {{ e.name }} =
            when (val idx = reader.readByte()) {
{%- for variant in e.variants %}
{%- if variant.fields.is_empty() %}
                {{ loop.index0 }}.toByte() -> {{ e.name }}.{{ variant.name }}()
{%- else %}
                {{ loop.index0 }}.toByte() -> {{ e.name }}.{{ variant.name }}(
{%- for field in variant.fields %}
                    {{ field.name | kotlin_sanitize_ident }} = reader.{{ field.ty | kotlin_reader_expr }},
{%- endfor %}
                )
{%- endif %}
{%- endfor %}
                else -> throw IllegalStateException("Invalid enum discriminant: $idx")
            }
    }
}
{%- endfor %}

{#- Opaque handles -#}
{%~ for s in ir.structs %}
{%- if s.is_opaque %}
{%- if s.doc.len() > 0 %}
/**
{%- for line in s.doc %}
 *{{ line }}
{%- endfor %}
 */
{%- endif %}
expect class {{ s.name }} : rs.koffi.KoffiHandleBase {
    private constructor(handleId: Long)

{%- let static_methods = ir.static_methods_of(s.name) %}
{%- if static_methods.len() > 0 %}
    companion object {
{%- for f in static_methods %}
{%- if f.doc.len() > 0 %}
        /**
{%- for line in f.doc %}
         *{{ line }}
{%- endfor %}
         */
{%- endif %}
        {{ f.is_async | kotlin_async_kw }}fun {{ f.name }}(
            {{- f.params | kotlin_params_common -}}
        ): {{ f.ret_ty | kotlin_type }}
{%- endfor %}
    }
{%- endif %}

{%- for f in ir.instance_methods_of(s.name) %}
{%- if f.doc.len() > 0 %}
    /**
{%- for line in f.doc %}
     *{{ line }}
{%- endfor %}
    */
{%- endif %}
    {{ f.is_async | kotlin_async_kw }}fun {{ f.name }}(
        {{- f.params | kotlin_params_common -}}
    ): {{ f.ret_ty | kotlin_type }}
{%- endfor %}

}
{%- endif %}
{%- endfor %}

{#- Free functions -#}
{%~ for f in ir.free_functions() %}
{%- if f.doc.len() > 0 %}
/**
{%- for line in f.doc %}
 *{{ line }}
{%- endfor %}
 */
{%- endif %}
expect {{ f.is_async | kotlin_async_kw }}fun {{ f.name }}({{ f.params | kotlin_params_common }}): {{ f.ret_ty | kotlin_type }}
{%- endfor %}
