{#- JVM + Android: JNI actual implementations -#}
package {{ namespace }}

import rs.koffi.KoffiHandleBase
import rs.koffi.KoffiHandle
import rs.koffi.serialize
import rs.koffi.deserialize

{# {%~ for i in ir.imports %}
import {{ i | qualified_name }}
{%- endfor %} #}

{# JNI native declarations object -#}
internal object {{ pkg_pascal }}Jni {
    init {
        {{ pkg_pascal }}Loader.load()
    }
{% for f in ir.functions %}
{%- let jni_name = f.parent_struct | kotlin_jni_method_name(f.rust_name) %}
    @JvmStatic
    external fun {{ jni_name }}(
{%- if f.parent_struct.is_some() %}handleId: Long{% if !f.params.is_empty() %}, {% endif %}{% endif %}{{ f.params | kotlin_params_jni -}}
    ): {{ f.ret_ty | kotlin_jni_type }}
{% endfor %}
    @JvmStatic
    external fun koffi_handle_release(handleId: Long)
}

{#- Opaque handle actuals -#}
{%- for s in ir.structs %}
{%- if s.is_opaque %}

actual class {{ s.name }} actual private constructor(handleId: Long) :
        rs.koffi.KoffiHandleBase(handleId) {
{%- for f in ir.methods_of(s.name) %}
{%- let jni_name = f.parent_struct | kotlin_jni_method_name(f.rust_name) %}

    actual {{ f.is_async | kotlin_async_kw }}fun {{ f.kotlin_name }}(
        {{- f.params | kotlin_params_common -}}
    ): {{ f.ret_ty | kotlin_type }} {
        check(!isClosed) { "Handle has been closed" }
        {{ f.params | kotlin_jni_return_expr(pkg_pascal, jni_name, f.ret_ty, true) }}
    }
{%- endfor %}
}
{%- endif %}
{%- endfor %}

{#- Free functions -#}
{%- for f in ir.free_functions() %}
actual {{ f.is_async | kotlin_async_kw }}fun {{ f.kotlin_name }}(
    {{- f.params | kotlin_params_common -}}
): {{ f.ret_ty | kotlin_type }} {
    {{ f.params | kotlin_jni_return_expr(pkg_pascal, f.rust_name, f.ret_ty, false) }}
}
{%- endfor %}
