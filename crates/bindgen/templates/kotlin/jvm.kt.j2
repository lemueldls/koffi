{#- JVM + Android: JNI actual implementations -#}
package {{ namespace }}

import rs.koffi.KoffiHandleBase
import rs.koffi.KoffiHandle
import rs.koffi.KoffiSerializer

// ── JNI native declarations ───────────────────────────────────────────────────
//
// One `external fun` per exported function. The JNI symbol is derived from
// the package, class name, and method name by the JVM at runtime.
// Method names incorporate the Rust module path to guarantee uniqueness across
// all functions in this crate, even when two modules export same-named items.

internal object {{ pkg_pascal }}Jni {
    init {
        {{ pkg_pascal }}Loader.load()
    }

    // Free functions
{%- for f in ir.free_functions() %}
{%- let jni_name = f | kotlin_jni_method_name %}
    @JvmStatic
    external fun {{ jni_name }}(
        {{- f.params | kotlin_params_jni(&false) -}}
    ): {{ f.ret_ty | kotlin_jni_type }}
{% endfor %}
    // Methods on opaque handles
{%- for s in ir.structs %}
{%- if s.is_opaque %}
{%- for f in ir.methods_of(s.name) %}
{%- let jni_name = f | kotlin_jni_method_name %}
    @JvmStatic
    external fun {{ jni_name }}(
{%- if f.receiver.is_some() %}handleId: Long{% if !f.params.is_empty() %}, {% endif %}{% endif %}
        {{- f.params | kotlin_params_jni(&false) -}}
    ): {{ f.ret_ty | kotlin_jni_type }}
{% endfor %}
{%- endif %}
{%- endfor %}

    @JvmStatic
    external fun koffi_handle_release(handleId: Long)
}

{#- Opaque handle actuals -#}
{%- for s in ir.structs %}
{%- if s.is_opaque %}

actual class {{ s.name }} actual private constructor(handleId: Long) :
        rs.koffi.KoffiHandleBase(handleId) {
{%- for f in ir.methods_of(s.name) %}
{%- let jni_name = f | kotlin_jni_method_name %}
{%- let has_receiver = f.receiver.is_some() %}

    actual {{ f.is_async | kotlin_async_kw }}fun {{ f.name }}(
        {{- f.params | kotlin_params_common -}}
    ): {{ f.ret_ty | kotlin_type }} {
{%- if has_receiver %}
        check(!isClosed) { "Handle has been closed" }
{%- endif %}
        {{ f | kotlin_jni_return_expr(pkg_pascal, jni_name, has_receiver) }}
    }
{%- endfor %}
}
{%- endif %}
{%- endfor %}

{#- Free function actuals — iterate only free functions, not methods -#}
{%- for f in ir.free_functions() %}
{%- let jni_name = f | kotlin_jni_method_name %}

actual {{ f.is_async | kotlin_async_kw }}fun {{ f.name }}(
    {{- f.params | kotlin_params_common -}}
): {{ f.ret_ty | kotlin_type }} {
    {{ f | kotlin_jni_return_expr(pkg_pascal, jni_name, &false) }}
}
{%- endfor %}
