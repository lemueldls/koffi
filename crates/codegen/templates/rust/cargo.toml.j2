# @generated by koffi

[workspace]

[package]
name = "{{ crate_name }}"
edition = "2024"

[lib]
crate-type = [{% for ct in crate_types %}"{{ ct }}"{% if !loop.last %}, {% endif %}{% endfor %}]

[dependencies]
{%- for dep in required_dependencies %}
{{ dep.name }} = { path = "{{ dep.path }}" }
{%- endfor %}
{%- for dep in optional_dependencies %}
{{ dep.name }} = { version = "{{ dep.version }}", optional = true }
{%- endfor %}

[features]
default = []
cabi = []
{%- for dep in optional_dependencies %}
{{ dep.feature }} = ["dep:{{ dep.name }}"]
{%- endfor %}

# koffi ships this crate as the ABI bridge; `pack -r` builds it in release
# like any other profile. `panic = "unwind"` is load-bearing:
# the exported fns lean on catch_unwind (guarded()/env.with_env) to turn
# Rust panics into a Kotlin-visible failure instead of aborting the process.
[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
panic = "unwind"
debug = false

# The source crate (`{{ source_crate_name }}`) compiles once per cargo tree
# per change: gen's extraction build compiles it as the root package, this
# tree as a dependency, and cargo names artifacts per workspace, so neither
# tree reuses the other's. These sections pin the source crate's own
# manifest profile for the dependency build; gen pins the same values into
# its extraction build with `--config`, so the two compiles always run at
# the same flags. Edit them to change the profile koffi uses for the source
# crate.
[profile.dev.package.{{ source_crate_name }}]
{%- for line in profile.dev_pin_lines() %}
{{ line }}
{%- endfor %}

[profile.release.package.{{ source_crate_name }}]
{%- for line in profile.release_pin_lines() %}
{{ line }}
{%- endfor %}
