# @generated by koffi

[workspace]

[package]
name = "{{ crate_name }}"
edition = "2024"

[lib]
crate-type = ["cdylib"]

[dependencies]
{%- for dep in required_dependencies %}
{{ dep.name }} = { path = "{{ dep.path }}" }
{%- endfor %}
{%- for dep in optional_dependencies %}
{{ dep.name }} = { version = "{{ dep.version }}", optional = true }
{%- endfor %}

[features]
default = []
cabi = []
{%- for dep in optional_dependencies %}
{{ dep.feature }} = ["dep:{{ dep.name }}"]
{%- endfor %}
