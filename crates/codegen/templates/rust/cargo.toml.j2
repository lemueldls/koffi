# @generated by koffi

[workspace]

[package]
name = "{{ crate_name }}"
edition = "2024"

[lib]
crate-type = [{% for ct in crate_types %}"{{ ct }}"{% if !loop.last %}, {% endif %}{% endfor %}]

[dependencies]
{%- for dep in required_dependencies %}
{{ dep.name }} = { path = "{{ dep.path }}" }
{%- endfor %}
{%- for dep in optional_dependencies %}
{{ dep.name }} = { version = "{{ dep.version }}", optional = true }
{%- endfor %}

[features]
default = []
cabi = []
{%- for dep in optional_dependencies %}
{{ dep.feature }} = ["dep:{{ dep.name }}"]
{%- endfor %}

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
panic = "unwind"
debug = false

[profile.dev.package.{{ source_crate_name }}]
{%- for line in profile.dev_pin_lines() %}
{{ line }}
{%- endfor %}

[profile.release.package.{{ source_crate_name }}]
{%- for line in profile.release_pin_lines() %}
{{ line }}
{%- endfor %}
