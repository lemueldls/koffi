{#~ The `actual fun` for one exported fn, rendered both inside the object
   (parent-having fns) and at top level (free fns). The body is identical;
   only the name differs, and `indent` carries the call site's indentation
   so object members stay nested. -#}
{%- macro ffm_fn(f, member_name, indent) -%}
{{ indent }}actual fun {{ member_name }}({% for p in f.params %}{{ p.name }}: {{ p.ty.kotlin_type() }}{% if !loop.last %}, {% endif %}{% endfor %}): {{ f.return_type.kotlin_type() }} {
{{ indent }}    Arena.ofConfined().use { callArena ->
        {%- for p in f.params %}
        {%- if p.ty.is_memory_backed() %}
{{ indent }}        val {{ p.name }}Segment = {{ p.ty.to_ffm_ident() }}({{ p.name }}, callArena)
        {%- endif %}
        {%- endfor %}
{{ indent }}        val __r = {{ f.unique_ident() }}.invokeWithArguments(
            {%- if f.return_type.is_memory_backed() %}callArena{% if !f.params.is_empty() %}, {% endif %}{%- endif -%}
            {%- for p in f.params -%}
            {%- if !loop.first %}, {% endif -%}
            {%- if p.ty.is_memory_backed() %}{{ p.name }}Segment{% elif p.ty.is_opaque() %}MemorySegment.ofAddress({{ p.name }}){% else %}{{ p.name }}{{ p.ty.to_ffm_suffix() }}{% endif -%}
            {%- endfor -%}
        )
        {%- if f.return_type.is_memory_backed() %}
{{ indent }}        return {{ f.return_type.from_ffm_ident() }}(__r as MemorySegment)
        {%- else %}
        {%- match f.return_type %}
        {%- when SchemaTypeRef::Scalar(kind) %}
{{ indent }}        return (__r as {{ kind.jvm_boxed_type() }}){{ kind.from_ffm_suffix() }}
        {%- when SchemaTypeRef::Enum { name, discriminant, .. } %}
{{ indent }}        return {{ name }}.fromDiscriminant((__r as {{ discriminant.jvm_boxed_type() }}){{ discriminant.from_ffm_suffix() }})
        {%- when SchemaTypeRef::Opaque { .. } %}
{{ indent }}        return (__r as MemorySegment).address()
        {%- when SchemaTypeRef::Struct { .. } %}
        {# unreachable: is_memory_backed covers structs #}
        {%- when SchemaTypeRef::Option { .. } %}
        {# unreachable: is_memory_backed covers wrappers #}
        {%- when SchemaTypeRef::Result { .. } %}
        {# unreachable: is_memory_backed covers wrappers #}
        {%- endmatch %}
        {%- endif %}
{{ indent }}    }
{{ indent }}}
{%- endmacro -%}

{#~ One FFI placement write. Opaque handles are raw addresses: the ADDRESS
   layout reads a `MemorySegment`, so the Long handle is wrapped before
   `segment.set`. Memory-backed types marshal through their own `toFfm`
   helper and are copied in with `asSlice().copyFrom()`. -#}
{%- macro ffm_write_value(ty, expr, offset) -%}
{%- if ty.is_memory_backed() -%}
segment.asSlice({{ offset }}L, {{ ty.kotlin_ffm_value_layout() }}.byteSize()).copyFrom({{ ty.to_ffm_ident() }}({{ expr }}, arena))
{%- elif ty.is_opaque() -%}
segment.set({{ ty.kotlin_ffm_value_layout() }}, {{ offset }}L, MemorySegment.ofAddress({{ expr }}))
{%- else -%}
segment.set({{ ty.kotlin_ffm_value_layout() }}, {{ offset }}L, {{ expr }}{{ ty.to_ffm_suffix() }})
{%- endif -%}
{%- endmacro -%}

{#~ The read side: `.address()` unwraps the segment the ADDRESS layout
   hands back into the caller's Long. -#}
{%- macro segment_read_value(ty, offset) -%}
{%- if ty.is_memory_backed() -%}
{{ ty.from_ffm_ident() }}(segment.asSlice({{ offset }}L, {{ ty.kotlin_ffm_value_layout() }}.byteSize()))
{%- elif ty.is_opaque() -%}
segment.get({{ ty.kotlin_ffm_value_layout() }}, {{ offset }}L).address()
{%- else -%}
segment.get({{ ty.kotlin_ffm_value_layout() }}, {{ offset }}L){{ ty.from_ffm_suffix() }}
{%- endif -%}
{%- endmacro -%}

{#~ The MethodHandle/layout/marshaller plumbing is top-level `private`, not
   object members: the top-level `actual fun`s for free fns need it, and
   object members can't see other classes' privates even in the same file.
   Top-level `private` is file-visible, which covers both call sites. -#}
private val arena: Arena = Arena.ofShared()
private val lookup: SymbolLookup = {{ schema.loader_object_name() }}.load(arena)
private val linker: Linker = Linker.nativeLinker()

{#~ Layouts in dependency order: any type whose FFM layout (or C typedef)
   embeds another's must be declared after it - Kotlin initializes `val`
   layout properties in declaration order (a forward reference is a
   compile error). Fieldless enums and scalars embed nothing, so they
   never appear here. -#}
{%~ for item in schema.types_in_layout_order() %}{%~ match item %}
{%- when LayoutOrderItem::Struct(s) %}
private val {{ s.kotlin_ffm_value_layout() }}: MemoryLayout = MemoryLayout.structLayout(
    {%- for entry in s.layout.entries %}
    {%- match entry %}
    {%- when LayoutEntry::Value { kotlin_layout, name } %}
    {{ kotlin_layout }}.withName("{{ name }}"){% if !loop.last %},{% endif %}
    {%- when LayoutEntry::Padding { bytes } %}
    MemoryLayout.paddingLayout({{ bytes }}){% if !loop.last %},{% endif %}
    {%- endmatch %}
    {%- endfor %}
)
{%- when LayoutOrderItem::DataEnum(e) %}
private val {{ e.kotlin_ffm_value_layout() }}: MemoryLayout = MemoryLayout.structLayout(
    {%- for entry in e.layout.entries %}
    {%- match entry %}
    {%- when LayoutEntry::Value { kotlin_layout, name } %}
    {{ kotlin_layout }}.withName("{{ name }}"){% if !loop.last %},{% endif %}
    {%- when LayoutEntry::Padding { bytes } %}
    MemoryLayout.paddingLayout({{ bytes }}){% if !loop.last %},{% endif %}
    {%- endmatch %}
    {%- endfor %}
)
{%- when LayoutOrderItem::Wrapper(w) %}
private val {{ w.kotlin_ffm_value_layout() }}: MemoryLayout = MemoryLayout.structLayout(
    {%- for entry in w.layout.entries %}
    {%- match entry %}
    {%- when LayoutEntry::Value { kotlin_layout, name } %}
    {{ kotlin_layout }}.withName("{{ name }}"){% if !loop.last %},{% endif %}
    {%- when LayoutEntry::Padding { bytes } %}
    MemoryLayout.paddingLayout({{ bytes }}){% if !loop.last %},{% endif %}
    {%- endmatch %}
    {%- endfor %}
)
{%- endmatch %}{%- endfor %}

{#~ Per-enum marshallers. `statusToFfm` materializes the enum's memory
   image (discriminant + active variant's payload at absolute offsets);
   `statusFromFfm` reads it back. Only data-carrying enums need these;
   fieldless ones cross the ABI as their plain discriminant scalar. -#}
{%~ for e in schema.enums %}{% if e.has_data %}
private fun {{ e.to_ffm_ident() }}(value: {{ e.name }}, arena: Arena): MemorySegment {
    val segment = arena.allocate({{ e.kotlin_ffm_value_layout() }})
    segment.set({{ e.discriminant.kotlin_ffm_value_layout() }}, 0L, value.discriminant{{ e.discriminant.to_ffm_suffix() }})
    when (value) {
        {%- for v in e.variants %}
        {%- if v.placements.is_empty() %}
        {{ e.name }}.{{ v.name }} -> {
        }
        {%- else %}
        is {{ e.name }}.{{ v.name }} -> {
            {%- for f in v.placements %}
            {{ ffm_write_value(&f.ty, &format!("value.{}", f.kotlin_name()), &f.offset) }}
            {%- endfor %}
        }
        {%- endif %}
        {%- endfor %}
    }
    return segment
}

private fun {{ e.from_ffm_ident() }}(segment: MemorySegment): {{ e.name }} {
    val d = segment.get({{ e.discriminant.kotlin_ffm_value_layout() }}, 0L){{ e.discriminant.from_ffm_suffix() }}
    return when (d) {
        {%- for v in e.variants %}
        {{ e.discriminant.kotlin_discriminant_literal(v.discriminant) }} -> {% if v.placements.is_empty() %}{{ e.name }}.{{ v.name }}{% else %}{{ e.name }}.{{ v.name }}({% for f in v.placements %}{{ f.kotlin_name() }} = {{ segment_read_value(&f.ty, &f.offset) }}{% if !loop.last %}, {% endif %}{% endfor %}){% endif %}
        {%- endfor %}
        else -> error("koffi: invalid {{ e.name }} discriminant $d")
    }
}
{%- endif %}{%- endfor %}

{#~ Per-struct marshallers. `payloadToFfm` materializes the struct's
   memory image (each field at its absolute offset); `payloadFromFfm`
   reads it back. Struct fields that are themselves structs or
   data-carrying enums are recursively marshalled via their own
   `toFfm`/`fromFfm` helpers and copied into the parent segment with
   `asSlice().copyFrom()`. Function declarations don't have the
   declaration-order constraint that `val` properties do, so the
   iteration order here doesn't matter. -#}
{%~ for s in schema.structs %}
private fun {{ s.to_ffm_ident() }}(value: {{ s.name }}, arena: Arena): MemorySegment {
    val segment = arena.allocate({{ s.kotlin_ffm_value_layout() }})
    {%- for placement in s.layout.placements %}
    {{ ffm_write_value(&placement.ty, &format!("value.{}", placement.kotlin_name()), &placement.offset) }}
    {%- endfor %}
    return segment
}

private fun {{ s.from_ffm_ident() }}(segment: MemorySegment): {{ s.name }} {
    return {{ s.name }}(
        {%- for placement in s.layout.placements %}
        {{ placement.kotlin_name() }} = {{ segment_read_value(&placement.ty, &placement.offset) }}{% if !loop.last %},{% endif %}
        {%- endfor -%}
    )
}
{%- endfor %}

{#~ Per-wrapper marshallers, same shape as the struct marshallers plus a
   `_d` discriminant byte at offset 0 (None/Err = 0, Some/Ok = 1) and the
   payload union at `{{ w.union_offset() }}`. The inner value rides the
   same copyFrom/set helpers as a struct field, so wrappers compose:
   `doesItDance(dance: Dancer?)` nests one wrapper inside another. -#}
{%~ for w in schema.wrappers %}
private fun {{ w.to_ffm_ident() }}(value: {{ w.kotlin_type() }}, arena: Arena): MemorySegment {
    val segment = arena.allocate({{ w.kotlin_ffm_value_layout() }})
    {%- if w.is_option() %}
    if (value != null) {
        segment.set(ValueLayout.JAVA_BYTE, 0L, 1.toByte())
        {{ ffm_write_value(&w.some().ty, &"value", &w.union_offset()) }}
    } else {
        segment.set(ValueLayout.JAVA_BYTE, 0L, 0.toByte())
    }
    {%- else %}
    when (value) {
        is KoffiResult.Ok<*> -> {
            segment.set(ValueLayout.JAVA_BYTE, 0L, 1.toByte())
            {{ ffm_write_value(&w.ok().ty, &format!("(value as KoffiResult.Ok<{}>).value", w.ok().ty.kotlin_type()), &w.union_offset()) }}
        }
        is KoffiResult.Err<*> -> {
            segment.set(ValueLayout.JAVA_BYTE, 0L, 0.toByte())
            {{ ffm_write_value(&w.err().ty, &format!("(value as KoffiResult.Err<{}>).error", w.err().ty.kotlin_type()), &w.union_offset()) }}
        }
    }
    {%- endif %}
    return segment
}

private fun {{ w.from_ffm_ident() }}(segment: MemorySegment): {{ w.kotlin_type() }} {
    {%- if w.is_option() %}
    return if (segment.get(ValueLayout.JAVA_BYTE, 0L) == 1.toByte()) {
        {{ segment_read_value(&w.some().ty, &w.union_offset()) }}
    } else {
        null
    }
    {%- else %}
    return if (segment.get(ValueLayout.JAVA_BYTE, 0L) == 1.toByte()) {
        KoffiResult.Ok({{ segment_read_value(&w.ok().ty, &w.union_offset()) }})
    } else {
        KoffiResult.Err({{ segment_read_value(&w.err().ty, &w.union_offset()) }})
    }
    {%- endif %}
}
{%- endfor %}

{%~ for f in schema.functions %}
