    lookup.find("{{ f.unique_ident() }}").orElseThrow(),
    FunctionDescriptor.of(
        {{- f.return_type.kotlin_ffm_value_layout() }}
        {%- for p in f.params %}, {{ p.ty.kotlin_ffm_value_layout() }}{% endfor -%}
    ),
)
{%- endfor %}

{#~ `actual object` matching the `expect object` in common.kt.j2, carrying
   only the parent-having fns. Free fns have their top-level `actual fun`s
   below. -#}
actual object {{ schema.ffi_object_name() }} {
    {%~ for f in schema.functions %}{%- if f.parent.is_some() %}
{{ ffm_fn(&f, f.ffi_member_name(), "    ") }}
    {%- endif %}{%- endfor %}
}

{%~ for f in schema.functions %}{%- if f.parent.is_none() %}
{{ ffm_fn(&f, f.kotlin_name, "") }}
{%- endif %}{%- endfor %}

object {{ schema.loader_object_name() }} {
    fun load(arena: Arena): SymbolLookup {
        return libraryLookup("{{ schema.glue_crate_ident() }}", arena)
    }

    fun libraryLookup(crateName: String, arena: Arena): SymbolLookup {
        val fileName = platformLibraryFileName(crateName)
        val resourcePath = "/native/$fileName"
        val resourceStream = {{ schema.loader_object_name() }}::class.java.getResourceAsStream(resourcePath)
            ?: error(
                "koffi: native library resource not found at $resourcePath. "
            )

        val tempFile = Files.createTempFile("koffi-$crateName-", platformLibrarySuffix())
        tempFile.toFile().deleteOnExit()
        resourceStream.use { input ->
            Files.copy(input, tempFile, StandardCopyOption.REPLACE_EXISTING)
        }

        return SymbolLookup.libraryLookup(tempFile, arena)
    }

    private fun platformLibraryFileName(crateName: String): String {
        val os = System.getProperty("os.name").lowercase()
        return when {
            os.contains("mac") -> "lib$crateName.dylib"
            os.contains("win") -> "$crateName.dll"
            else -> "lib$crateName.so"
        }
    }

    private fun platformLibrarySuffix(): String {
        val os = System.getProperty("os.name").lowercase()
        return when {
            os.contains("mac") -> ".dylib"
            os.contains("win") -> ".dll"
            else -> ".so"
        }
    }
}
