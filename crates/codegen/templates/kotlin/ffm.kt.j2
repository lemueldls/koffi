// otherwise collide with the common source set's own `*Kt` facade.
@file:JvmName("{{ schema.crate_ident_pascal() }}Jvm")

package {{ schema.kotlin_package() }}

import java.lang.foreign.*
import java.lang.invoke.MethodHandle
import java.nio.file.Files
