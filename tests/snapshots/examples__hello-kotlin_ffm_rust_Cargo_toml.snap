# @generated by koffi

[workspace]

[package]
name = "hello_kotlin_glue"
edition = "2024"

[lib]
crate-type = ["cdylib"]

[dependencies]
hello-kotlin = { path = "../../../../../examples/hello-kotlin" }
jni = { version = "0.22", optional = true }
wasm-bindgen = { version = "0.2", optional = true }

[features]
default = []
cabi = []
jni = ["dep:jni"]
wasm = ["dep:wasm-bindgen"]

# koffi ships this crate as the ABI bridge; `pack -r` builds it in release
# like any other profile. `panic = "unwind"` is load-bearing:
# the exported fns lean on catch_unwind (guarded()/env.with_env) to turn
# Rust panics into a Kotlin-visible failure instead of aborting the process.
[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
panic = "unwind"
debug = false
