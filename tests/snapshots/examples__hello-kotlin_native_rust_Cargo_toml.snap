---
source: tests/examples.rs
expression: "fs::read_to_string(&file)?"
---
# @generated by koffi

[workspace]

[package]
name = "hello_kotlin_glue"
edition = "2024"

[lib]
crate-type = ["cdylib", "staticlib"]

[dependencies]
hello-kotlin = { path = "../../../../../examples/hello-kotlin" }
jni = { version = "0.22", optional = true }
wasm-bindgen = { version = "0.2", optional = true }

[features]
default = []
cabi = []
jni = ["dep:jni"]
wasm = ["dep:wasm-bindgen"]

# koffi ships this crate as the ABI bridge; `pack -r` builds it in release
# like any other profile. `panic = "unwind"` is load-bearing:
# the exported fns lean on catch_unwind (guarded()/env.with_env) to turn
# Rust panics into a Kotlin-visible failure instead of aborting the process.
[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
panic = "unwind"
debug = false

# The source crate (`hello-kotlin`) compiles once per cargo tree
# per change: gen's extraction build compiles it as the root package, this
# tree as a dependency, and cargo names artifacts per workspace, so neither
# tree reuses the other's. These sections pin the source crate's own
# manifest profile for the dependency build; gen pins the same values into
# its extraction build with `--config`, so the two compiles always run at
# the same flags. Edit them to change the profile koffi uses for the source
# crate.
[profile.dev.package.hello-kotlin]
codegen-units = 256
debug = 2
incremental = true
opt-level = 0
overflow-checks = true
strip = "none"

[profile.release.package.hello-kotlin]
codegen-units = 16
debug = 0
incremental = false
opt-level = 3
overflow-checks = false
strip = "none"
