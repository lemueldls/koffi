pub fn guarded<R>(f: impl FnOnce() -> R + std::panic::UnwindSafe) -> R {
    match std::panic::catch_unwind(f) {
        Ok(v) => v,
        Err(_) => std::process::abort(),
    }
}

#[unsafe(no_mangle)]
pub unsafe extern "C" fn koffi_free_bytes(ptr: *mut u8, len: usize) {
    guarded(|| {
        if !ptr.is_null() {
            let _: ::std::boxed::Box<[u8]> =
                unsafe { ::std::boxed::Box::from_raw(::std::slice::from_raw_parts_mut(ptr, len)) };
        }
    })
}
