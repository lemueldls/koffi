private fun allocateWire(size: Int): ByteBuffer =
    ByteBuffer.allocateDirect(size).order(ByteOrder.LITTLE_ENDIAN)
private fun ByteBuffer.section(offset: Int): ByteBuffer =
    duplicate().position(offset).slice().order(ByteOrder.LITTLE_ENDIAN)

private fun statusToWire(v: Status, buf: ByteBuffer) {
    buf.putInt(0, v.discriminant)
    when (v) {
        is Status.Busy -> {
            buf.putInt(4, v.field0.toInt())
        }
        is Status.Error -> {
            buf.putInt(4, v.code.toInt())
        }
        else -> {}
    }
}

private fun statusFromWire(buf: ByteBuffer): Status {
    val d = buf.getInt(0)
    return when (d) {
        0 -> Status.Idle
        1 -> Status.Busy(field0 = buf.getInt(4).toUInt())
        2 -> Status.Error(code = buf.getInt(4).toUInt())
        -1 -> Status.Failed
        else -> error("koffi: invalid Status discriminant $d")
    }
}

private fun statusToBuf(v: Status): ByteBuffer {
    val buf = allocateWire(8)
    statusToWire(v, buf)
    return buf
}

private fun payloadToWire(v: Payload, buf: ByteBuffer) {
    buf.putShort(0, v.data.toShort())
}

private fun payloadFromWire(buf: ByteBuffer): Payload =
    Payload(
        data = buf.getShort(0).toUShort())

private fun payloadToBuf(v: Payload): ByteBuffer {
    val buf = allocateWire(2)
    payloadToWire(v, buf)
    return buf
}
private fun pointToWire(v: Point, buf: ByteBuffer) {
    buf.putInt(0, v.x)
    buf.putInt(4, v.y)
}

private fun pointFromWire(buf: ByteBuffer): Point =
    Point(
        x = buf.getInt(0),
        y = buf.getInt(4))

private fun pointToBuf(v: Point): ByteBuffer {
    val buf = allocateWire(8)
    pointToWire(v, buf)
    return buf
}
private fun rectToWire(v: Rect, buf: ByteBuffer) {
    pointToWire(v.topLeft, buf.section(0))
    pointToWire(v.bottomRight, buf.section(8))
}

private fun rectFromWire(buf: ByteBuffer): Rect =
    Rect(
        topLeft = pointFromWire(buf.section(0)),
        bottomRight = pointFromWire(buf.section(8)))

private fun rectToBuf(v: Rect): ByteBuffer {
    val buf = allocateWire(16)
    rectToWire(v, buf)
    return buf
}
private fun status_holderToWire(v: StatusHolder, buf: ByteBuffer) {
    statusToWire(v.status, buf.section(0))
    buf.put(8, v.tag.toByte())
}

private fun status_holderFromWire(buf: ByteBuffer): StatusHolder =
    StatusHolder(
        status = statusFromWire(buf.section(0)),
        tag = buf.get(8).toUByte())

private fun status_holderToBuf(v: StatusHolder): ByteBuffer {
    val buf = allocateWire(12)
    status_holderToWire(v, buf)
    return buf
}

