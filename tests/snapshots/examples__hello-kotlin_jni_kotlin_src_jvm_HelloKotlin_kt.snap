object HelloKotlinLoader {
    fun extractLibrary(): String {
        val fileName = platformLibraryFileName("hello_kotlin_glue")
        val resourcePath = "/native/$fileName"
        val resourceStream = HelloKotlinLoader::class.java.getResourceAsStream(resourcePath)
            ?: error(
                "koffi: native library resource not found at $resourcePath. "
            )

        val tempFile = Files.createTempFile("koffi-hello_kotlin_glue-", platformLibrarySuffix())
        tempFile.toFile().deleteOnExit()
        resourceStream.use { input ->
            Files.copy(input, tempFile, StandardCopyOption.REPLACE_EXISTING)
        }

        return tempFile.toAbsolutePath().toString()
    }

    private fun platformLibraryFileName(crateName: String): String {
        val os = System.getProperty("os.name").lowercase()
        return when {
            os.contains("mac") -> "lib$crateName.dylib"
            os.contains("win") -> "$crateName.dll"
            else -> "lib$crateName.so"
        }
    }

    private fun platformLibrarySuffix(): String {
        val os = System.getProperty("os.name").lowercase()
        return when {
            os.contains("mac") -> ".dylib"
            os.contains("win") -> ".dll"
            else -> ".so"
        }
    }
}
