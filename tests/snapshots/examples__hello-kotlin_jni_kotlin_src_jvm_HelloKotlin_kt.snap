actual fun ride(dance: Dancer?): Dancer? {
    val out = allocateWire(12)
    HelloKotlinFfi.rideImpl(__koffi_option___koffi_struct_hello_kotlin_DancerToBuf(dance), out)
    return __koffi_option___koffi_struct_hello_kotlin_DancerFromWire(out)
}
actual fun howLong(seconds: Double?): Double =
    HelloKotlinFfi.howLongImpl(__koffi_option_f64ToBuf(seconds))
actual fun cStatus(): CStatus =
    HelloKotlinFfi.cStatusImpl().let { CStatus.fromDiscriminant(it.toUInt()) }
actual fun favorite(): UInt? {
    val out = allocateWire(8)
    HelloKotlinFfi.favoriteImpl(out)
    return __koffi_option_u32FromWire(out)
}
actual fun nominate(x: UInt): KoffiResult<Payload, Status> {
    val out = allocateWire(12)
    HelloKotlinFfi.nominateImpl(x.toInt(), out)
    return __koffi_result___koffi_struct_hello_kotlin_Payload___koffi_enum_hello_kotlin_StatusFromWire(out)
}
actual fun mood(): Mood {
    val out = allocateWire(8)
    HelloKotlinFfi.moodImpl(out)
    return moodFromWire(out)
}
actual fun statusCode(s: Status): UInt =
    HelloKotlinFfi.statusCodeImpl(statusToBuf(s)).toUInt()
actual fun paint(color: Boolean?): Boolean =
    HelloKotlinFfi.paintImpl(__koffi_option_boolToBuf(color))
actual fun rectArea(r: Rect): Int =
    HelloKotlinFfi.rectAreaImpl(rectToBuf(r))
actual fun moodIsFlying(m: Mood): Boolean =
    HelloKotlinFfi.moodIsFlyingImpl(moodToBuf(m))
actual fun encrypt(secret: SafePacket): SafePacket {
    val out = allocateWire(5)
    HelloKotlinFfi.encryptImpl(safe_packetToBuf(secret), out)
    return safe_packetFromWire(out)
}
actual fun emptyString(): String =
    HelloKotlinFfi.emptyStringImpl()
actual fun maybePayload(show: Boolean): Payload? {
    val out = allocateWire(4)
    HelloKotlinFfi.maybePayloadImpl(show, out)
    return __koffi_option___koffi_struct_hello_kotlin_PayloadFromWire(out)
}
actual fun takeString(s: String): Boolean =
    HelloKotlinFfi.takeStringImpl(s)
actual fun addOptional(a: UInt, b: UInt?): UInt =
    HelloKotlinFfi.addOptionalImpl(a.toInt(), __koffi_option_u32ToBuf(b)).toUInt()
actual fun hello(): Payload {
    val out = allocateWire(2)
    HelloKotlinFfi.helloImpl(out)
    return payloadFromWire(out)
}
actual fun rectTopLeft(r: Rect): Point {
    val out = allocateWire(8)
    HelloKotlinFfi.rectTopLeftImpl(rectToBuf(r), out)
    return pointFromWire(out)
}
actual fun stringPair(a: String, b: String): Boolean =
    HelloKotlinFfi.stringPairImpl(a, b)
actual fun bytesPair(a: ByteArray, b: ByteArray): Boolean =
    HelloKotlinFfi.bytesPairImpl(a, b)

object HelloKotlinLoader {
    fun extractLibrary(): String {
        val fileName = platformLibraryFileName("hello_kotlin_glue")
        val resourcePath = "/native/$fileName"
        val resourceStream = HelloKotlinLoader::class.java.getResourceAsStream(resourcePath)
            ?: error(
                "koffi: native library resource not found at $resourcePath. "
            )

        val tempFile = Files.createTempFile("koffi-hello_kotlin_glue-", platformLibrarySuffix())
        tempFile.toFile().deleteOnExit()
        resourceStream.use { input ->
            Files.copy(input, tempFile, StandardCopyOption.REPLACE_EXISTING)
        }

        return tempFile.toAbsolutePath().toString()
    }

    private fun platformLibraryFileName(crateName: String): String {
        val os = System.getProperty("os.name").lowercase()
        return when {
            os.contains("mac") -> "lib$crateName.dylib"
            os.contains("win") -> "$crateName.dll"
            else -> "lib$crateName.so"
        }
    }

    private fun platformLibrarySuffix(): String {
        val os = System.getProperty("os.name").lowercase()
        return when {
            os.contains("mac") -> ".dylib"
            os.contains("win") -> ".dll"
            else -> ".so"
        }
    }
}
